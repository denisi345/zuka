function switchAuth(m){['login','signup','forgot'].forEach(x=>{document.getElementById(x+'Form').classList.add('hidden');const tab=document.getElementById('tab'+x.charAt(0).toUpperCase()+x.slice(1));if(tab)tab.classList.remove('on')});if(m==='login'){document.getElementById('loginForm').classList.remove('hidden');document.getElementById('tabLogin').classList.add('on')}if(m==='signup'){document.getElementById('signupForm').classList.remove('hidden');document.getElementById('tabSignup').classList.add('on')}if(m==='forgot'){document.getElementById('forgotForm').classList.remove('hidden');document.getElementById('tabForgot').classList.add('on')}}
function showPage(p){['home','reels','friends','groups','market','watch','saved','events','pages','memories','fundraiser','search'].forEach(x=>{let el=document.getElementById(x+'Page');if(el)el.classList.add('hidden')});document.getElementById(p+'Page').classList.remove('hidden');if(p==='friends')renderPeople();if(p==='groups')renderGroups();if(p==='market')renderMarket();if(p==='watch')renderWatch();if(p==='saved')renderSaved();if(p==='events')renderEvents();if(p==='pages')renderPages();if(p==='memories')renderMemories();if(p==='fundraiser')renderFunds();if(p==='reels')renderReels();window.scrollTo(0,0)}
function toggleDark(){document.body.classList.toggle('dark')}
function videoCall(){toast('Video Call started')}function voiceCall(){toast('Voice Call started')}
function copyProfileLink(){navigator.clipboard.writeText(location.href);toast('Profile link copied')}
function submitVerification(){const n=document.getElementById('verifyName').value||currentUser?.email;verifyQueue.push({email:currentUser?.email||'',name:n,time:new Date().toLocaleString()});localStorage.setItem('zuka_verify_queue',JSON.stringify(verifyQueue));toast('Verification submitted. Admin will review.');closeModal('verifyModal')}
function downloadData(){toast('Your data is downloading')}
function deactivateAccount(){if(confirm('Deactivate account?'))toast('Account deactivated.')}
function deleteAccount(){if(confirm('Delete account permanently?'))toast('Account deletion requested.')}
function loginGoogle(){toast('Google Login - Connecting')}
function signupGoogle(){toast('Google Signup - Connecting')}
function loginPhone(){toast('Phone login - OTP will be sent')}
async function forgotPassword(){const e=document.getElementById('forgotEmail').value;if(!e){toast('Enter Email or Phone');return}toast('Recovery code sent to '+e)}
async function resetPassword(){const c=document.getElementById('forgotCode').value;if(!c){toast('Enter recovery code');return}const np=document.getElementById('newPassInput').value;if(!np){toast('Enter new password');return}toast('Password reset success. Now login.');switchAuth('login')}
async function resizeImage(file,size){return new Promise((resolve)=>{const reader=new FileReader();reader.onload=(e)=>{const img=new Image();img.onload=()=>{const canvas=document.createElement('canvas');canvas.width=size;canvas.height=size;const ctx=canvas.getContext('2d');ctx.fillStyle='#ffffff';ctx.fillRect(0,0,size,size);const scale=Math.max(size/img.width,size/img.height);const w=img.width*scale;const h=img.height*scale;ctx.drawImage(img,(size-w)/2,(size-h)/2,w,h);resolve(canvas.toDataURL('image/jpeg',0.85));};img.src=e.target.result;};reader.readAsDataURL(file);});}
function fileToBase64(file){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=rej;r.readAsDataURL(file)})}
document.getElementById('postImage').addEventListener('change',async function(){const f=this.files[0];if(!f)return;const resized=await resizeImage(f,1080);const prev=document.getElementById('postPreview');prev.src=resized;prev.style.display='block';prev.dataset.resized=resized;});
document.getElementById('marketImage').addEventListener('change',async function(){const f=this.files[0];if(!f)return;const resized=await resizeImage(f,1080);const prev=document.getElementById('marketPreview');prev.src=resized;prev.style.display='block';prev.dataset.resized=resized;});
async function doSignup(){const first=document.getElementById('firstNameInput').value.trim();const last=document.getElementById('lastNameInput').value.trim();const email=document.getElementById('signupEmail').value.trim();const phone=document.getElementById('signupPhone').value.trim();const password=document.getElementById('signupPass').value;const dob=document.getElementById('dobInput').value;const gender=document.getElementById('genderInput').value;const name=(first+' '+last).trim()||email.split('@')[0];if(!email||!password){document.getElementById('msg').innerText='Enter Email and Password';return}const {data,error}=await sb.auth.signUp({email,password});if(error){document.getElementById('msg').innerText=error.message;return}if(data.user){await sb.from('profiles').insert([{user_id:data.user.id,email,full_name:name,avatar_url:'',is_verified:false,phone:phone,dob:dob,gender:gender}])}toast('Account created. Now Log In');switchAuth('login');}
async function doLogin(){const email=document.getElementById('emailInput').value.trim();const password=document.getElementById('passInput').value;if(!email||!password){document.getElementById('msg').innerText='Enter Email and Password';return}const {error}=await sb.auth.signInWithPassword({email,password});if(error){document.getElementById('msg').innerText=error.message;return}checkUser();}
async function doLogout(){await sb.auth.signOut();location.reload()}
async function checkUser(){const {data}=await sb.auth.getUser();if(data.user){currentUser=data.user;document.getElementById('authBox').classList.add('hidden');document.getElementById('topBar').classList.remove('hidden');document.getElementById('appBox').classList.remove('hidden');const {data:prof}=await sb.from('profiles').select('*').eq('user_id',data.user.id).maybeSingle();currentProfile=prof;const name=prof?.full_name||data.user.email;const av=prof?.avatar_url||'';document.getElementById('sideName').innerText=name;if(av)document.getElementById('sideAvatar').src=av;if(av)document.getElementById('myAvatar').src=av;document.getElementById('profileName').innerText=name;document.getElementById('profileEmail').innerText=data.user.email;if(av)document.getElementById('profileAvatar').src=av;document.getElementById('profileBio').value=prof?.bio||'';document.getElementById('sideTick').innerHTML=prof?.is_verified?'Verified':'';document.getElementById('profileTick').innerHTML=prof?.is_verified?'Verified':'Not Verified';if(prof?.cover_url)document.getElementById('coverImg').src=prof.cover_url;loadFeed();loadNews('world');renderStories();renderPeople();renderNotifs();renderMarket();}}
async function saveProfile(){if(!currentUser)return;const bio=document.getElementById('profileBio').value;const avatar_url=document.getElementById('profileAvatarInput').value||currentProfile?.avatar_url||'';const cover_url=document.getElementById('profileCoverInput').value||'';await sb.from('profiles').upsert({user_id:currentUser.id,email:currentUser.email,full_name:currentProfile?.full_name||currentUser.email,bio,avatar_url,is_verified:currentProfile?.is_verified||false});if(cover_url)document.getElementById('coverImg').src=cover_url;toast('Profile saved');closeModal('profileModal');checkUser();}
function formatPost(text){if(!text)return'';let t=text.replace(/</g,'&lt;');t=t.replace(/#(\w+)/g,'<span class="hashtag">#$1</span>');t=t.replace(/@(\w+)/g,'<span class="mention">@$1</span>');return t;}
async function doPost(){const text=document.getElementById('postInput').value.trim();const privacy=document.getElementById('postPrivacy').value;const feeling=document.getElementById('postFeeling').value;const type=document.getElementById('postType').value;const tags=document.getElementById('tagInput').value;const hashtags=document.getElementById('hashtagInput').value;const poll=document.getElementById('pollInput').value;const imgFile=document.getElementById('postImage').files[0];const vidFile=document.getElementById('postVideo').files[0];if(!text&&!imgFile&&!vidFile){toast('Write something');return}if(!currentUser){toast('Login first');return}let image_url=document.getElementById('postPreview').dataset.resized||'';let video_url='';if(imgFile&&!image_url)image_url=await resizeImage(imgFile,1080);if(vidFile)video_url=await fileToBase64(vidFile);let content=text;if(feeling)content+=' '+feeling;if(tags)content+=' Tagged: '+tags;if(hashtags)content+=' '+hashtags;if(poll)content+=' Poll: '+poll;const {error}=await sb.from('posts').insert([{content,user_id:currentUser.id,image_url,video_url,privacy,post_type:type}]);if(error){toast(error.message);return}document.getElementById('postInput').value='';document.getElementById('postImage').value='';document.getElementById('postVideo').value='';document.getElementById('postPreview').style.display='none';document.getElementById('postPreview').dataset.resized='';if(type==='Reel'&&(image_url||video_url)){localReels.unshift({caption:content,img:image_url||video_url,user:currentProfile?.full_name||'You'});localStorage.setItem('zuka_reels',JSON.stringify(localReels));}addNotif('Your post was published');loadFeed();toast('Posted');}
async function loadFeed(){const {data,error}=await sb.from('posts').select('*, profiles!posts_user_id_fkey(full_name,avatar_url,is_verified)').order('created_at',{ascending:false}).limit(50);if(error){const {data:d2}=await sb.from('posts').select('*').order('created_at',{ascending:false}).limit(50);allPosts=d2||[];renderFeed();return;}allPosts=data||[];renderFeed();}
async function renderFeed(){let list=allPosts;if(currentFilter!=='All'){if(currentFilter==='Reel')list=list.filter(p=>p.post_type==='Reel'||p.video_url);else if(currentFilter==='Poll')list=list.filter(p=>p.post_type==='Poll');else if(currentFilter==='News')list=list.filter(p=>p.post_type==='News');else list=list.filter(p=>(p.privacy||'Public')===currentFilter);}if(!list.length){document.getElementById('feedList').innerHTML='<div class="card">No posts yet. Be the first to post.</div>';return}let html='';for(const p of list){const prof=p.profiles||{};const name=prof.full_name||'User';const av=prof.avatar_url||'';const tick=prof.is_verified?' <span class="tick">Verified</span>':'';const time=new Date(p.created_at).toLocaleString();const isMine=currentUser&&p.user_id===currentUser.id;const {count:likeCount}=await sb.from('likes').select('*',{count:'exact',head:true}).eq('post_id',p.id);const {data:comments}=await sb.from('comments').select('*').eq('post_id',p.id).order('created_at',{ascending:true});html+=`<div class="card"><div class="post-head">${av?`<img src="${av}">`:''}<div><b>${name}${tick}</b><small>${time} - ${p.privacy||'Public'} - ${p.post_type||'Post'}</small></div><div style="margin-left:auto"><button onclick="toggleMenu('${p.id}')">Menu</button><div id="menu-${p.id}" style="display:none">${isMine?`<button onclick="editPost('${p.id}')">Edit Post</button><button onclick="deletePost('${p.id}')">Delete Post</button>`:''}<button onclick="savePost('${p.id}')">Save</button><button onclick="hidePost('${p.id}')">Hide</button><button onclick="reportPost('${p.id}')">Report</button></div></div></div><div class="post-text">${formatPost(p.content||'')}</div>${p.image_url?`<img class="post-img" src="${p.image_url}">`:''}${p.video_url?`<video class="post-video" controls src="${p.video_url}"></video>`:''}<div class="like-row"><span>${likeCount||0} Reactions</span><span>${(comments||[]).length} Comments</span></div><div class="actions"><button onclick="likePost('${p.id}')">Like</button><button onclick="document.getElementById('c-${p.id}').focus()">Comment</button><button onclick="sharePost('${p.id}')">Share</button><button onclick="followUser('${p.user_id}')">Follow</button></div><div>${(comments||[]).map(c=>`<div class="one-comment">${c.content}</div>`).join('')}</div><div class="comment-box">${currentProfile?.avatar_url?`<img src="${currentProfile.avatar_url}">`:''}<input id="c-${p.id}" placeholder="Write a comment"><button onclick="commentPost('${p.id}')">Send</button></div></div>`;}document.getElementById('feedList').innerHTML=html;}
function toggleMenu(id){const el=document.getElementById('menu-'+id);el.style.display=el.style.display==='none'?'block':'none'}
async function editPost(id){const t=prompt('Edit your post:');if(!t)return;await sb.from('posts').update({content:t}).eq('id',id);toast('Post edited');loadFeed()}
async function deletePost(id){if(!confirm('Delete this post?'))return;await sb.from('posts').delete().eq('id',id);toast('Post deleted');loadFeed()}
function hidePost(id){toast('Post hidden')}
function filterFeed(f,el){currentFilter=f;document.querySelectorAll('.chip').forEach(c=>c.classList.remove('on'));if(el)el.classList.add('on');renderFeed()}
async function likePost(id){if(!currentUser){toast('Login first');return}const {data:ex}=await sb.from('likes').select('id').eq('post_id',id).eq('user_id',currentUser.id).maybeSingle();if(ex){await sb.from('likes').delete().eq('id',ex.id);}else{await sb.from('likes').insert([{post_id:id,user_id:currentUser.id}])}loadFeed()}
async function commentPost(id){const inp=document.getElementById('c-'+id);const text=inp.value.trim();if(!text)return;const {error}=await sb.from('comments').insert([{post_id:id,user_id:currentUser.id,content:text}]);if(error){toast(error.message);return}addNotif('New comment on your post');loadFeed()}
async function sharePost(id){const url=location.href.split('?')[0]+'?share='+id;try{await navigator.clipboard.writeText(url);toast('Link copied')}catch(e){prompt('Copy link:',url)}}
function savePost(id){if(!localSaved.includes(id)){localSaved.push(id);localStorage.setItem('zuka_saved',JSON.stringify(localSaved));toast('Saved')}else toast('Already saved')}
function reportPost(id){reportCount++;localStorage.setItem('zuka_reports',reportCount);toast('Post reported to Admin.')}
async function followUser(uid){if(!currentUser)return;if(uid===currentUser.id){toast('This is you');return}toast('Following user')}
function addStory(input){const f=input.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{localStories.unshift(r.result);localStorage.setItem('zuka_stories',JSON.stringify(localStories));renderStories();toast('Story posted');};r.readAsDataURL(f)}
function renderStories(){let myStories=localStories.map(s=>{return `<div class="story"><img src="${s}"><span>You</span></div>`}).join('');let createHtml=`<div class="story" onclick="document.getElementById('storyFile').click()"><div style="background:#e4e6eb;height:100%;display:flex;align-items:center;justify-content:center;font-size:28px">+</div><span>Create Story</span><span class="add">+</span></div>`;document.getElementById('storiesList').innerHTML=createHtml+myStories;if(!localStories.length){document.getElementById('storiesList').innerHTML=createHtml;}}
function renderPeople(){document.getElementById('peopleList').innerHTML='No suggestions yet. Invite friends to join.';document.getElementById('requestList').innerHTML='No friend requests.';document.getElementById('allFriends').innerHTML='No friends yet.';document.getElementById('onlineList').innerHTML='No contacts online.';}
function renderGroups(){document.getElementById('groupList').innerHTML=(localGroups.length?localGroups.map(g=>`<div class="menu-item">${g} <button style="margin-left:auto" onclick="toast('Joined')">Join</button></div>`).join(''):'No groups yet. Create one.')}
function createGroup(){const v=document.getElementById('newGroup').value.trim();if(!v)return;localGroups.push(v);localStorage.setItem('zuka_groups',JSON.stringify(localGroups));renderGroups();toast('Group created')}
function setMarketFilter(f,el){marketFilter=f;document.querySelectorAll('#marketPage .chip').forEach(c=>c.classList.remove('on'));if(el)el.classList.add('on');renderMarket()}
function renderMarket(){let list=[...localMarket];const q=(document.getElementById('marketSearch')?.value||'').toLowerCase();if(q)list=list.filter(m=>(m.title+' '+m.desc+' '+m.loc+' '+m.category).toLowerCase().includes(q));if(marketFilter!=='All')list=list.filter(m=>m.category===marketFilter);const sort=document.getElementById('marketSort')?.value||'new';if(sort==='low')list.sort((a,b)=>a.price-b.price);if(sort==='high')list.sort((a,b)=>b.price-a.price);if(!list.length){document.getElementById('marketList').innerHTML='<p>No items found.</p>';return;}document.getElementById('marketList').innerHTML=list.map((m,i)=>`<div class="market-card">${m.img?`<img class="market-img" src="${m.img}">`:''}<div style="display:flex;justify-content:space-between;margin-top:10px"><b>${m.title}</b><span class="badge">${m.category}</span></div><div class="market-price">${m.priceText}</div><div class="market-meta">Condition: ${m.condition} | Location: ${m.loc} | Seller: ${m.seller}</div><p>${m.desc||''}</p><div style="display:flex;gap:8px"><button class="primary" style="flex:1" onclick="contactSeller('${m.seller}')">Message Seller</button><button style="flex:1" onclick="makeOffer('${m.title}')">Make Offer</button><button style="flex:1" onclick="saveMarketItem(${i})">Save Item</button></div></div>`).join('');}
function contactSeller(name){toast('Messaging '+name+' in Messages');openModal('msgModal');}
function makeOffer(title){const o=prompt('Your offer for '+title);if(o)toast('Offer sent: '+o)}
function saveMarketItem(i){toast('Item saved')}
function addMarket(){const t=document.getElementById('marketTitle').value.trim();const priceVal=document.getElementById('marketPrice').value.trim();const cat=document.getElementById('marketCategory').value;const cond=document.getElementById('marketCondition').value;const loc=document.getElementById('marketLoc').value.trim();const desc=document.getElementById('marketDesc').value.trim();if(!t){toast('Enter item name');return}const price=parseInt(priceVal.replace(/[^0-9]/g,''))||0;const img=document.getElementById('marketPreview').dataset.resized||'';localMarket.unshift({title:t,price,priceText:price?price.toLocaleString(): '',category:cat,condition:cond,loc,desc,img,seller:currentProfile?.full_name||'You'});localStorage.setItem('zuka_market',JSON.stringify(localMarket));document.getElementById('marketTitle').value='';document.getElementById('marketPrice').value='';document.getElementById('marketDesc').value='';document.getElementById('marketImage').value='';document.getElementById('marketPreview').style.display='none';document.getElementById('marketPreview').dataset.resized='';renderMarket();toast('Item posted')}
function renderWatch(){document.getElementById('watchList').innerHTML='No videos yet. Post a video to see it here.'}
function renderSaved(){document.getElementById('savedList').innerHTML=(localCollections.length?localCollections.map(c=>`<div>Collection: ${c}</div>`).join(''):'')+(localSaved.length?localSaved.map(id=>`<div>Saved Post: ${id}</div>`).join(''):'No saved posts yet')}
function createCollection(){const v=document.getElementById('collectionInput').value.trim();if(!v)return;localCollections.push(v);localStorage.setItem('zuka_collections',JSON.stringify(localCollections));renderSaved();toast('Collection created')}
function renderEvents(){document.getElementById('eventList').innerHTML=(localEvents.length?localEvents.map(e=>`<div class="menu-item">${e}</div>`).join(''):'No events yet.')}
function addEvent(){const v=document.getElementById('eventName').value.trim();if(!v)return;localEvents.push(v);localStorage.setItem('zuka_events',JSON.stringify(localEvents));renderEvents();toast('Event created')}
function renderPages(){document.getElementById('pageList').innerHTML=(localPages.length?localPages.map(p=>`<div class="menu-item">${p}</div>`).join(''):'No pages yet.')}
function createPage(){const v=document.getElementById('pageName').value.trim();if(!v)return;localPages.push(v);localStorage.setItem('zuka_pages',JSON.stringify(localPages));renderPages();toast('Page created')}
function renderMemories(){document.getElementById('memoryList').innerHTML='No memories yet.'}
function renderFunds(){document.getElementById('fundList').innerHTML=(localFunds.length?localFunds.map(f=>`<div class="card">${f}</div>`).join(''):'No fundraisers yet.')}
function addFund(){const t=document.getElementById('fundTitle').value;if(!t)return;localFunds.push(t);localStorage.setItem('zuka_funds',JSON.stringify(localFunds));renderFunds();toast('Fundraiser created')}
function renderReels(){document.getElementById('reelsList').innerHTML=localReels.map(r=>`<div class="reel"><img src="${r.img}"><div class="r-info"><b>${r.user}</b><p>${r.caption}</p></div></div>`).join('')||'No reels yet.'}
function postReel(){const cap=document.getElementById('reelCaption').value||'My Reel';const music=document.getElementById('reelMusic').value||'Original Audio';const f=document.getElementById('reelFile').files[0];if(f){const r=new FileReader();r.onload=()=>{localReels.unshift({caption:cap+' - Music: '+music,img:r.result,user:currentProfile?.full_name||'You'});localStorage.setItem('zuka_reels',JSON.stringify(localReels));renderReels();toast('Reel posted')};r.readAsDataURL(f);}else{toast('Select a file for reel')}}
function doSearch(q){if(!q){if(!document.getElementById('searchPage').classList.contains('hidden'))showPage('home');return}showPage('search');const filtered=allPosts.filter(p=>(p.content||'').toLowerCase().includes(q.toLowerCase()));document.getElementById('searchResults').innerHTML=filtered.length?filtered.map(p=>`<div class="card">${p.content}</div>`).join(''):`<div>Searching for "<b>${q}</b>"</div>`}
function addNotif(t){localNotifs.unshift({text:t,time:new Date().toLocaleString()});localStorage.setItem('zuka_notifs',JSON.stringify(localNotifs.slice(0,20)));renderNotifs()}
function renderNotifs(){document.getElementById('notifList').innerHTML=localNotifs.length?localNotifs.map(n=>`<div class="card">${n.text}<br><small>${n.time}</small></div>`).join(''):'No notifications';document.getElementById('notifCount').innerText=localNotifs.length}
function markAllRead(){localNotifs=[];localStorage.setItem('zuka_notifs',JSON.stringify(localNotifs));renderNotifs();toast('All marked as read')}
function clearNotifs(){localNotifs=[];localStorage.setItem('zuka_notifs',JSON.stringify(localNotifs));renderNotifs();toast('Notifications cleared')}
function sendChat(){const v=document.getElementById('chatInput').value.trim();if(!v)return;localChats.push({from:'You',text:v});localStorage.setItem('zuka_chats',JSON.stringify(localChats));document.getElementById('chatInput').value='';renderChat()}
function renderChat(){document.getElementById('chatList').innerHTML=localChats.map(c=>`<div class="one-comment"><b>${c.from}:</b> ${c.text}</div>`).join('')||'No messages yet.'}
async function loadNews(topic){const box=document.getElementById('newsList');if(!box)return;box.innerHTML='Loading news';let rss='https://feeds.bbci.co.uk/news/world/rss.xml';if(topic==='technology')rss='https://feeds.bbci.co.uk/news/technology/rss.xml';if(topic==='sports')rss='https://feeds.bbci.co.uk/sport/rss.xml';if(topic==='business')rss='https://feeds.bbci.co.uk/news/business/rss.xml';if(topic==='health')rss='https://feeds.bbci.co.uk/news/health/rss.xml';try{const res=await fetch('https://api.rss2json.com/v1/api?rss_url='+encodeURIComponent(rss)+'&count=8');const j=await res.json();box.innerHTML=j.items.map(i=>`<div style="margin-bottom:12px;cursor:pointer" onclick="window.open('${i.link}','_blank')"><b>${i.title}</b><br><small>${new Date(i.pubDate).toLocaleString()}</small></div>`).join('');}catch(e){box.innerHTML='News failed. Check internet.'}}
function goLive(){const t=document.getElementById('liveTitle').value||'Live Now';toast('You are LIVE. Title: '+t);closeModal('liveModal');addNotif('You went Live: '+t)}
function adminLogin(){if(document.getElementById('adminPass').value===ADMIN_PASSWORD){document.getElementById('adminPanel').classList.remove('hidden');loadAdminStats();toast('Welcome Admin');}else toast('Wrong password')}
async function loadAdminStats(){const {count:p}=await sb.from('posts').select('*',{count:'exact',head:true});const {count:u}=await sb.from('profiles').select('*',{count:'exact',head:true});document.getElementById('adminPosts').innerText=p||0;document.getElementById('adminUsers').innerText=u||0;document.getElementById('adminReports').innerText=reportCount;document.getElementById('verifyQueue').innerHTML=verifyQueue.length?verifyQueue.map(v=>`<div>${v.name} - ${v.email} <button onclick="toast('Approved')">Approve</button><button onclick="toast('Rejected')">Reject</button></div>`).join(''):'No verification requests yet.';document.getElementById('reportQueue').innerHTML=reportCount?reportCount+' reports':'No reports.'}
async function adminVerify(){const email=document.getElementById('adminVerifyEmail').value.trim();if(!email)return;await sb.from('profiles').update({is_verified:true}).eq('email',email);toast(email+' is now Verified');loadAdminStats();loadFeed()}
async function adminAnnounce(){const t=document.getElementById('adminAnnounce').value.trim();if(!t||!currentUser)return;await sb.from('posts').insert([{content:'Announcement: '+t,user_id:currentUser.id,privacy:'Public',post_type:'News'}]);toast('Announcement posted to all');loadFeed()}
function createAd(){const t=document.getElementById('adminAdTitle').value;if(!t){toast('Enter Ad Title');return}toast('Ad created: '+t)}
renderChat();renderNotifs();renderMarket();checkUser();
</script>
